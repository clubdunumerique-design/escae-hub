# Clé publique "anon" Supabase (visible dans Settings > API)
# Cette clé est exposée côté client — RLS doit être activé
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imp2ZmxuYmVzZWd0cGVzcWR1bHF6Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTE1NjM3NzAsImV4cCI6MjEwNzEzOTc3MH0.-QxhFUhjVgXyW1k3weZsOWHfpRe-Mfg2uMJD2tPvWKM

# Clé "service_role" Supabase (NE PAS préfixer NEXT_PUBLIC_)
# Utilisée uniquement dans les Server Actions / Route Handlers
# NE JAMAIS exposer dans le navigateur
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imp2ZmxuYmVzZWd0cGVzcWR1bHF6Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc5MTU2Mzc3MCwiZXhwIjoyMTA3MTM5NzcwfQ.HTxCW1EOoFNtueLOw4yLOvWG-7LgNQ6h75v4pCg0lBY

# --- Resend (service e-mail transactionnel) ---
# Clé API Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_your-api-key-here

# Adresse d'expéditeur vérifiée dans Resend
RESEND_FROM_EMAIL=noreply@escae-hub.example.com

# --- Application ---
# URL publique de l'application (sans slash final)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environnement de déploiement : development | staging | production
APP_ENV=development

# --- Sécurité (décisions provisoires — à confirmer) ---
# PROVISOIRE : Durée de vie des liens de réinitialisation de mot de passe (en secondes)
# Valeur provisoire : 3600 (1 heure). À confirmer selon politique institutionnelle.
AUTH_PASSWORD_RESET_EXPIRY_SECONDS=3600

# PROVISOIRE : Durée de conservation des données étudiantes (en jours)
# Valeur provisoire : 1825 (5 ans). À confirmer selon réglementation applicable.
DATA_RETENTION_DAYS=1825
