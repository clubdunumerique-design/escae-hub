# ============================================================
# ESCAE-BÉNIN Innovation Hub — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs réelles
# NE JAMAIS committer .env.local dans Git
# ============================================================

# --- Supabase (obligatoire) ---
# URL du projet Supabase (visible dans Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Clé publique Supabase (Recommandé : nouvelle clé publishable sb_publishable_xxx)
# Visible dans Settings > API Keys > Publishable and secret API keys
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key-here
# Solution de repli legacy (ancienne clé anon JWT) :
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Clé secrète serveur Supabase (Recommandé : nouvelle clé secrète sb_secret_xxx)
# NE PAS préfixer par NEXT_PUBLIC_ — Utilisée uniquement côté serveur
SUPABASE_SECRET_KEY=sb_secret_your-secret-key-here
# Solution de repli legacy (ancienne clé service_role JWT) :
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# --- Resend (service e-mail transactionnel) ---
# Clé API Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_your-api-key-here

# Adresse d'expéditeur vérifiée dans Resend
RESEND_FROM_EMAIL=noreply@escae-hub.example.com

# --- Application ---
# URL publique de l'application (sans slash final)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environnement de déploiement : development | staging | production
APP_ENV=development

# --- Sécurité (décisions provisoires — à confirmer) ---
# PROVISOIRE : Durée de vie des liens de réinitialisation de mot de passe (en secondes)
# Valeur provisoire : 3600 (1 heure). À confirmer selon politique institutionnelle.
AUTH_PASSWORD_RESET_EXPIRY_SECONDS=3600

# PROVISOIRE : Durée de conservation des données étudiantes (en jours)
# Valeur provisoire : 1825 (5 ans). À confirmer selon réglementation applicable.
DATA_RETENTION_DAYS=1825
