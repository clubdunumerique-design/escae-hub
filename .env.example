# ============================================================
# ESCAE-BÉNIN Innovation Hub — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs réelles
# NE JAMAIS committer .env.local dans Git
# ============================================================

# --- Supabase (obligatoire) ---
# URL du projet Supabase (visible dans Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Clé publique Supabase (Recommandé : nouvelle clé publishable sb_publishable_xxx)
# Visible dans Settings > API Keys > Publishable and secret API keys
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key-here
# Solution de repli legacy (ancienne clé anon JWT) :
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Clé secrète serveur Supabase (Recommandé : nouvelle clé secrète sb_secret_xxx)
# NE PAS préfixer par NEXT_PUBLIC_ — Utilisée uniquement côté serveur
SUPABASE_SECRET_KEY=sb_secret_your-secret-key-here
# Solution de repli legacy (ancienne clé service_role JWT) :
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# --- E-mails ---
# Les e-mails de confirmation, récupération et invitation sont envoyés par Supabase Auth.
# Configurez un fournisseur SMTP dans les paramètres Auth du projet Supabase avant le lancement.
# Les notifications de projets sont actuellement uniquement in-app (pas d'e-mails transactionnels).
# SMTP des e-mails de relance (identifiants privés, côté serveur uniquement).
# Reprendre les paramètres du fournisseur configuré dans Supabase Auth.
# SMTP_HOST=smtp.votre-fournisseur.com
# SMTP_PORT=465
# SMTP_USER=adresse-expediteur@votre-domaine.com
# SMTP_PASSWORD=mot-de-passe-ou-mot-de-passe-application
# SMTP_FROM=ESCAE Innovation Hub <adresse-expediteur@votre-domaine.com>

# --- Application ---
# Origine publique de l'application, sans chemin ni slash final.
# En production Vercel, remplacer par le domaine HTTPS réel et l'ajouter à l'URL allow-list Supabase.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# La durée de validité des liens Auth et la conservation des données ne sont pas
# pilotées par des variables d'environnement dans cette application. Configurez-les
# dans Supabase et selon la politique de conservation validée par l'établissement.
